  <!-- ===== FONTS & STYLES ===== -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
  <link rel="stylesheet" href="intro.css" />
</head>

<body class="intro-active">

  <!-- ===== INTRO LOADER OVERLAY ===== -->
  <div id="intro-overlay" aria-hidden="true" role="presentation">
    <div class="intro-container">
      <img src="logo.png" alt="Boss Event Decorators Logo" class="intro-logo" id="introLogo">
      <div class="intro-loader-wrapper">
        <div class="intro-progress-bar">
          <div class="intro-progress-fill" id="introProgress"></div>
        </div>
        <div class="intro-loading-text" id="introCounter">0 %</div>
      </div>
    </div>
  </div>
  <!-- ===== END INTRO ===== -->
  <!-- ===== NAVBAR ===== -->
  <nav id="navbar" role="navigation" aria-label="Main navigation">
    <div class="nav-inner">

      <!-- Left spacer (balances the right button) -->
      <div class="nav-spacer"></div>

      <!-- Center brand -->
      <a href="#hero" class="nav-logo--center" aria-label="Boss Event Decorators Home">
        BOSS EVENT DECORATORS
      </a>

      <!-- Right: hamburger only -->
      <button class="nav-hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>

    </div>

    <!-- Full-screen mobile menu -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
      <a href="#services">Services</a>
      <a href="/gallery">Gallery</a>
      <a href="#about">About</a>
      <a href="#contact">Enquire Now</a>
    </div>
  </nav>


  <!-- ===== HERO — Minimal White with center video ===== -->
  <section id="hero" class="hero-min" aria-label="Hero">

    <!-- Scattered words + center media grid -->
    <div class="hero-min__stage">



      <!-- Left scatter -->
      <div class="hero-min__scatter hero-min__scatter--left">
        <span class="scatter-w s-w1">Crafting</span>
        <span class="scatter-w s-w2">celebrations,</span>
      </div>

      <!-- Center video / image -->
      <div class="hero-min__media" style="position: relative;">
        <video
          autoplay muted loop playsinline
          poster="hero.png"
          aria-label="Boss Event Decorators wedding event highlight"
          id="heroVideo">
          <!-- Replace src with your actual video file -->
          <source src="lv_0_20260803133702.mp4" type="video/mp4" />
          <img src="hero.png" alt="Elegant wedding setup by Boss Event Decorators Cuddalore" />
        </video>
        <!-- Volume Toggle Button -->
        <button id="videoMuteBtn" class="video-mute-btn" aria-label="Unmute video">
          <svg id="icon-muted" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
          <svg id="icon-unmuted" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        </button>
      </div>

      <!-- Right scatter -->
      <div class="hero-min__scatter hero-min__scatter--right">
        <span class="scatter-w s-w3">unforgettable</span>
        <span class="scatter-w s-w4">experiences.</span>
      </div>

    </div>

    <div class="hero-min__tagline">
      <p><%- content.hero_tagline %></p>
    </div>

    <!-- Scroll indicator -->
    <div class="hero-min__scroll" aria-hidden="true">
      <span class="scroll-bar"></span>
    </div>

  </section>




  <!-- ===== WORK SHOWCASE ===== -->
  <!-- ===== SERVICES STORY ===== -->
  <section id="services" class="services-story" aria-labelledby="services-heading">
    <!-- Sticky Content Container -->
    <div class="ss-sticky-container">
      <div class="ss-content">
        <h2 id="services-heading" class="ss-title">Services</h2>
        <div class="ss-text">
          <p>Curated catering and event management services tailored to your unique celebration.</p>
        </div>
      </div>
    </div>
    
    <!-- Scrolling Images Container -->
    <div class="ss-scroll-container">
      
      <% services.forEach((service, index) => { %>
        <% if (index % 2 === 0) { %>
          <div class="ss-img ss-img--left reveal" <%- index > 1 ? 'style="margin-top: 20vh;"' : '' %>>
            <img src="<%= service.image_url %>" alt="<%= service.title %>" loading="lazy" />
            <div class="ss-caption"><%= service.title %></div>
          </div>
        <% } else { %>
          <div class="ss-img ss-img--right reveal">
            <img src="<%= service.image_url %>" alt="<%= service.title %>" loading="lazy" />
            <div class="ss-caption"><%= service.title %></div>
          </div>
        <% } %>
      <% }) %>

    </div>
  </section>

  <section id="work" class="work-showcase" aria-labelledby="work-heading">
    
    <div class="work-showcase__header">
      <h2 id="work-heading" class="work-showcase__title">Our Work</h2>
      <p class="work-showcase__sub">A collection of moments that reflect our journey together,<br>filled with love, laughter, and everything that brought us here.</p>
    </div>

    <!-- Horizontal scrolling track -->
    <div class="work-showcase__scroll" id="workScroll">
      <div class="work-showcase__track">
        <div class="ws-item"><img src="hero.png" alt="Wedding setup" loading="lazy"></div>
        <div class="ws-item"><img src="decor.png" alt="Event decor" loading="lazy"></div>
        <div class="ws-item"><img src="catering.png" alt="Catering" loading="lazy"></div>
        <div class="ws-item"><img src="hero.png" alt="Celebration" loading="lazy"></div>
        <!-- Duplicated for infinite scroll -->
        <div class="ws-item"><img src="hero.png" alt="Wedding setup" loading="lazy"></div>
        <div class="ws-item"><img src="decor.png" alt="Event decor" loading="lazy"></div>
        <div class="ws-item"><img src="catering.png" alt="Catering" loading="lazy"></div>
        <div class="ws-item"><img src="hero.png" alt="Celebration" loading="lazy"></div>
      </div>
    </div>

    <!-- Explore Gallery Button -->
    <div style="text-align: center; margin-top: 2rem;">
      <a href="/gallery" class="work-showcase__btn">Explore Gallery</a>
    </div>

  </section>


  <!-- ===== ABOUT US — Danny Studio style ===== -->
  <section id="about" class="about-studio" aria-labelledby="about-heading">

    <!-- Top title area -->
    <div class="about-studio__header">
      <p class="about-studio__label">Wedding Planner</p>
      <h2 id="about-heading" class="about-studio__title"><%= content.about_title %></h2>
    </div>

    <!-- Center photo with dot on top -->
    <div class="about-studio__frame-wrap">
      <div class="about-studio__dot" aria-hidden="true"></div>
      <div class="about-studio__frame">
        <img src="hero.png" alt="Boss Event Decorators elegant wedding setup Cuddalore" />
      </div>
      
      <!-- Stats touching the bottom of the image -->
      <div class="about-studio__stats">
        <div class="as-stat">
          <div class="as-stat-icon">🏆</div>
          <div class="as-stat-text"><strong>10+</strong> Years of<br/>Experience</div>
        </div>
        <div class="as-stat">
          <div class="as-stat-icon">🍽️</div>
          <div class="as-stat-text"><strong>1000+</strong> Successful<br/>Events</div>
        </div>
        <div class="as-stat">
          <div class="as-stat-icon">👨‍🍳</div>
          <div class="as-stat-text"><strong>25+</strong> Professional<br/>Staff</div>
        </div>
        <div class="as-stat">
          <div class="as-stat-icon">😊</div>
          <div class="as-stat-text"><strong>100%</strong> Client<br/>Satisfaction</div>
        </div>
      </div>
    </div>


    <!-- Text body below scattered words -->
    <div class="about-studio__body">
      <%- content.about_text %>

    </div>

  </section>


  <section id="contact" class="contact-minimal" aria-labelledby="contact-heading">
    <div class="contact-minimal-inner">
      <div class="cm-header">
        <h2 id="contact-heading" class="cm-title">GET IN TOUCH</h2>
        <p class="cm-sub">Tell us a little about it. We reply within 24 hours.</p>
      </div>
      
      <form class="cm-form" id="enquiryForm" novalidate aria-label="Enquiry form">
        <div class="cm-group">
          <label for="nameInput">Your Name / Couple Names *</label>
          <input type="text" id="nameInput" name="name" class="cm-input" placeholder="e.g. Priya & Rajan" required>
        </div>
        <div class="cm-group">
          <label for="emailInput">Email *</label>
          <input type="email" id="emailInput" name="email" class="cm-input" placeholder="you@email.com" required>
        </div>
        <div class="cm-group">
          <label for="phoneInput">Phone Number *</label>
          <input type="tel" id="phoneInput" name="phone" class="cm-input" placeholder="+91 XXXXX XXXXX" required>
        </div>
        <div class="cm-group">
          <label for="eventType">Event Type</label>
          <select id="eventType" name="event" class="cm-input">
            <option value="wedding">Wedding / Reception</option>
            <option value="engagement">Engagement</option>
            <option value="naming">Naming Ceremony</option>
            <option value="birthday">Birthday Party</option>
            <option value="corporate">Corporate Event</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="cm-group">
          <label for="dateInput">Event Date</label>
          <input type="text" id="dateInput" name="date" class="cm-input" placeholder="e.g. 15th Nov 2026">
        </div>
        <div class="cm-group">
          <label for="guestsInput">Expected Guest Count</label>
          <input type="number" id="guestsInput" name="guests" class="cm-input" placeholder="e.g. 500">
        </div>
        <div class="cm-group">
          <label for="venueInput">Location / Venue</label>
          <input type="text" id="venueInput" name="venue" class="cm-input" placeholder="City, Hall Name">
        </div>
        <div class="cm-group">
          <label for="messageInput">Tell us about your requirements</label>
          <textarea id="messageInput" name="message" class="cm-input" placeholder="Food preferences, decor themes, special arrangements..." rows="2"></textarea>
        </div>
        <button type="submit" class="cm-btn" id="submitBtn">Send Inquiry</button>
      </form>
    </div>
  </section>
  <footer class="footer" role="contentinfo">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo-mark">Boss</span>
        <p class="footer-tagline">Crafting Celebrations Since 2006</p>
      </div>
      <div class="footer-links">
        <a href="#services">Services</a>
        <a href="/gallery">Gallery</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
      <div class="footer-location">
        <p>Shakti Nagar, Vriddhachalam</p>
        <p>Tamil Nadu, India</p>
        <p>Opens at 08:00 AM</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Boss Event Decorators and Event Management Service. All rights reserved.</p>
    </div>
  </footer>

