</head>

<body class="page-food-items">
  <!-- ===== NAVBAR ===== -->
  <nav id="navbar" role="navigation" aria-label="Main navigation">
    <div class="nav-inner">
      <!-- Left: Minimal Back Button pointing back to /food -->
      <div class="nav-spacer" style="display: flex; align-items: center;">
        <a href="/food" class="nav-back-btn" aria-label="Back to Food Menus">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>FOOD</span>
        </a>
      </div>

      <a href="/" class="nav-logo--center" aria-label="RPG Catering Home">
        RPG CATERING
      </a>

      <button class="nav-hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
      <a href="/#services">Services</a>
      <a href="/food">Explore Our Food</a>
      <a href="/food-items">Food Items</a>
      <a href="/gallery">Gallery</a>
      <a href="/#about">About</a>
      <a href="/#contact">Enquire Now</a>
    </div>
  </nav>

  <!-- ===== MAIN CONTENT ===== -->
  <main class="food-main">
    <section class="food-items-page-section" aria-label="Food Items by Category">
      <div class="food-items-container">
        
        <!-- Header -->
        <div class="food-items-header">
          <h1 class="food-items-title">Food <span class="food-gold-accent">Items</span></h1>
          <div class="food-ornament-sm" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z"></path>
              <circle cx="12" cy="12" r="1.5" fill="currentColor"></circle>
            </svg>
          </div>
        </div>

        <!-- Category Carousel / Horizontal Tabs -->
        <div class="food-category-wrapper">
          <div class="food-category-track" id="categoryTrack">
            <!-- Dynamically populated categories -->
          </div>
          <button type="button" class="category-scroll-btn" id="categoryScrollRight" aria-label="Scroll categories right">&rarr;</button>
        </div>

        <!-- Active Category Display Card -->
        <div class="food-items-display" id="foodItemsDisplay">
          <!-- Left: 2 Columns of Food Items -->
          <div class="food-items-content">
            <h2 class="food-active-category-name" id="activeCategoryName">Soups</h2>
            <div class="food-grid-items" id="activeItemsGrid">
              <!-- Dynamically populated items with green veg icons -->
            </div>
          </div>

          <!-- Right: Featured Food Image -->
          <div class="food-items-media">
            <img src="/food-assets/soup.jpg" id="activeCategoryImg" alt="Featured Soups" class="food-featured-img" loading="lazy" />
          </div>
        </div>

        <!-- Back to Food Menus Action at bottom -->
        <div class="food-items-bottom-action">
          <a href="/food" class="btn-pill-light">
            <span class="btn-arrow">&larr;</span>
            <span>Back to Catering Menus</span>
          </a>
        </div>

      </div>
    </section>
  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="footer" role="contentinfo">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo-mark">RPG</span>
        <p class="footer-tagline">Crafting Celebrations Since 2006</p>
      </div>
      <div class="footer-links">
        <a href="/#services">Services</a>
        <a href="/food">Explore Our Food</a>
        <a href="/food-items">Food Items</a>
        <a href="/gallery">Gallery</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </div>
      <div class="footer-location">
        <p>Manjakkuppam, Cuddalore</p>
        <p>Tamil Nadu, India</p>
        <p>Opens at 08:00 AM</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 RPG Catering and Event Management Service. All rights reserved.</p>
    </div>
  </footer>

  <!-- ===== FLOATING ACTIONS ===== -->
  <a href="tel:+919600662794" class="call-float" aria-label="Call us">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
  </a>

  <a href="https://wa.me/919600662794" class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- Script for Navigation & Interactive Food Items Browser -->
  <script>
    // Navigation Hamburger
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (hamburgerBtn && mobileMenu) {
      hamburgerBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('active');
        hamburgerBtn.classList.toggle('active');
        hamburgerBtn.setAttribute('aria-expanded', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      mobileMenu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          mobileMenu.classList.remove('active');
          hamburgerBtn.classList.remove('active');
          document.body.style.overflow = '';
        });
      });
    }

    // Navbar Scroll Background
    window.addEventListener('scroll', () => {
      const nav = document.getElementById('navbar');
      if (window.scrollY > 40) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    });

    // ===== FOOD ITEMS CATEGORY DATA =====
    const foodCategories = [
      {
        id: "soups",
        name: "Soups",
        image: "/food-assets/soup.jpg",
        items: [
          "Tomato Soup",
          "Cream of Mushroom Soup",
          "Sweet Corn Soup",
          "Cream of Tomato Soup",
          "Hot & Sour Soup",
          "Veg Noodle Soup",
          "Veg Clear Soup",
          "Lemon Coriander Soup",
          "Manchow Soup",
          "Mixed Vegetable Soup"
        ]
      },
      {
        id: "starters",
        name: "Starters",
        image: "/food-assets/starters.jpg",
        items: [
          "Paneer Tikka",
          "Gobi - 65",
          "Veg Hara Bara Kabab",
          "Mushroom Manchurian",
          "Shanghai Green Spring Roll",
          "Veg Green Corn Roll",
          "Cashew Pakoda",
          "Veg Seekh Kabab",
          "Honey Dry Ball Manchurian",
          "Cheese Corn Nuggets"
        ]
      },
      {
        id: "rice",
        name: "Rice Varieties",
        image: "/food-assets/rice.jpg",
        items: [
          "Ghee Rice",
          "Curd Rice (Bagala Bath)",
          "Jeera Rice",
          "Karnataka Bisi Bele Bath",
          "Steamed Rice",
          "Sambar Rice",
          "Lemon Rice",
          "Coconut Rice",
          "Tamarind Rice",
          "Ghee Cashew Rice"
        ]
      },
      {
        id: "biryani",
        name: "Biryani & Pulao",
        image: "/food-assets/biryani.jpg",
        items: [
          "Vegetable Biryani",
          "Jeera Pulao",
          "Mushroom Biryani",
          "Peas Pulao",
          "Paneer Biryani",
          "Veg Pulao",
          "Hyderabadi Veg Biryani",
          "Mint Pulao",
          "Kashmiri Pulao",
          "Curd Rice"
        ]
      },
      {
        id: "roti",
        name: "Roti Varieties",
        image: "/food-assets/roti.jpg",
        items: [
          "Butter Naan",
          "Tandoori Roti",
          "Rumali Roti",
          "Phulka",
          "Chapathi",
          "Poricha Parotta",
          "Coin Parotta",
          "Garlic Naan",
          "Kulcha",
          "Aloo Paratha"
        ]
      },
      {
        id: "idli",
        name: "Idli Varieties",
        image: "/food-assets/idli.jpg",
        items: [
          "Steamed Idli",
          "Podi Idli",
          "Mini Ghee Idli",
          "Kanchipuram Idli",
          "Rava Idli",
          "Dhokla Idli",
          "Sambar Idli",
          "Fried Idli",
          "Pepper Idli",
          "Stuffed Idli"
        ]
      }
    ];

    let currentCategoryIndex = 0;
    const categoryTrack = document.getElementById('categoryTrack');
    const activeCategoryName = document.getElementById('activeCategoryName');
    const activeItemsGrid = document.getElementById('activeItemsGrid');
    const activeCategoryImg = document.getElementById('activeCategoryImg');
    const categoryScrollRight = document.getElementById('categoryScrollRight');

    const vegBadgeSvg = `
      <svg class="veg-leaf-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
      </svg>
    `;

    function renderCategories() {
      if (!categoryTrack) return;
      categoryTrack.innerHTML = '';
      foodCategories.forEach((cat, index) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `food-category-pill ${index === currentCategoryIndex ? 'is-active' : ''}`;
        btn.setAttribute('aria-pressed', index === currentCategoryIndex ? 'true' : 'false');
        btn.innerHTML = `
          <div class="category-pill-thumb">
            <img src="${cat.image}" alt="${cat.name}" loading="lazy" />
          </div>
          <span class="category-pill-label">${cat.name}</span>
        `;
        btn.addEventListener('click', () => {
          switchCategory(index);
        });
        categoryTrack.appendChild(btn);
      });
    }

    function switchCategory(index) {
      currentCategoryIndex = index;
      const cat = foodCategories[index];

      // Update pills active state
      const pills = categoryTrack.querySelectorAll('.food-category-pill');
      pills.forEach((p, idx) => {
        if (idx === index) {
          p.classList.add('is-active');
          p.setAttribute('aria-pressed', 'true');
          p.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          p.classList.remove('is-active');
          p.setAttribute('aria-pressed', 'false');
        }
      });

      if (activeCategoryName) activeCategoryName.textContent = cat.name;

      if (activeItemsGrid) {
        activeItemsGrid.innerHTML = '';
        cat.items.forEach(item => {
          const itemEl = document.createElement('div');
          itemEl.className = 'food-item-row';
          itemEl.innerHTML = `
            <span class="food-item-name">${item}</span>
            <span class="food-item-veg-badge" title="Vegetarian Pure">${vegBadgeSvg}</span>
          `;
          activeItemsGrid.appendChild(itemEl);
        });
      }

      if (activeCategoryImg) {
        activeCategoryImg.style.opacity = '0';
        setTimeout(() => {
          activeCategoryImg.src = cat.image;
          activeCategoryImg.alt = cat.name;
          activeCategoryImg.style.opacity = '1';
        }, 150);
      }
    }

    if (categoryScrollRight) {
      categoryScrollRight.addEventListener('click', () => {
        if (categoryTrack) {
          categoryTrack.scrollBy({ left: 160, behavior: 'smooth' });
        }
      });
    }

    // Initialize
    renderCategories();
    switchCategory(0);
  </script>
</body>
</html>
