  <meta name="keywords" content="RPG catering food items, catering menu Cuddalore, biryani catering, starters catering, wedding menu items" />
  <meta name="author" content="RPG Catering &amp; Studio, Cuddalore" />
  <meta name="robots" content="index, follow" />

  <!-- ===== OPEN GRAPH ===== -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Food Items by Category | RPG Catering &amp; Studio" />
  <meta property="og:description" content="Explore our authentic catering dishes organized by category." />
