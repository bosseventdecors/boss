  <!-- Script for Navigation, Modals & Food Items Browser -->
  <script>
    // Navigation Hamburger
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (hamburgerBtn && mobileMenu) {
      hamburgerBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('active');
        hamburgerBtn.classList.toggle('active');
        hamburgerBtn.setAttribute('aria-expanded', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });
      mobileMenu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          mobileMenu.classList.remove('active');
          hamburgerBtn.classList.remove('active');
          document.body.style.overflow = '';
        });
      });
    }

    // Navbar Scroll Background
    window.addEventListener('scroll', () => {
      const nav = document.getElementById('navbar');
      if (window.scrollY > 40) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    });

    // Option 01: PDF Preview Modal
    const openPdfModalBtn = document.getElementById('openPdfModalBtn');
    const closePdfModalBtn = document.getElementById('closePdfModalBtn');
    const pdfModal = document.getElementById('pdfPreviewModal');
    const modalBackdrop = document.getElementById('modalBackdrop');

    function openPdfModal() {
      if (!pdfModal) return;
      pdfModal.classList.add('is-open');
      pdfModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closePdfModal() {
      if (!pdfModal) return;
      pdfModal.classList.remove('is-open');
      pdfModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (openPdfModalBtn) openPdfModalBtn.addEventListener('click', openPdfModal);
    if (closePdfModalBtn) closePdfModalBtn.addEventListener('click', closePdfModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closePdfModal);

    // Option 02: Collection Modal
    const openCollectionModalBtn = document.getElementById('openCollectionModalBtn');
    const closeCollectionModalBtn = document.getElementById('closeCollectionModalBtn');
    const collectionModal = document.getElementById('collectionModal');
    const collectionModalBackdrop = document.getElementById('collectionModalBackdrop');

    function openCollectionModal() {
      if (!collectionModal) return;
      collectionModal.classList.add('is-open');
      collectionModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeCollectionModal() {
      if (!collectionModal) return;
      collectionModal.classList.remove('is-open');
      collectionModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (openCollectionModalBtn) openCollectionModalBtn.addEventListener('click', openCollectionModal);
    if (closeCollectionModalBtn) closeCollectionModalBtn.addEventListener('click', closeCollectionModal);
    if (collectionModalBackdrop) collectionModalBackdrop.addEventListener('click', closeCollectionModal);

    // Close on Escape Key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closePdfModal();
        closeCollectionModal();
      }
    });
  </script>
