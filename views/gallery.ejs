<!DOCTYPE html>
<html lang="en" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ===== PRIMARY SEO ===== -->
  <title>Our Gallery | RPG Catering &amp; Studio</title>
  <meta name="description" content="View our curated gallery of weddings, engagements, and corporate events by RPG Catering &amp; Studio in Cuddalore." />
  <meta name="keywords" content="RPG catering gallery, wedding photos Cuddalore, event management gallery, RPG studio gallery" />
  <meta name="author" content="RPG Catering &amp; Studio, Cuddalore" />
  <meta name="robots" content="index, follow" />

  <!-- ===== CANONICAL ===== -->
  <link rel="canonical" href="https://rkcatering.in/gallery.html" />

  <!-- ===== FONTS & STYLES ===== -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>

<body>
  <!-- ===== NAVBAR ===== -->
  <nav id="navbar" role="navigation" aria-label="Main navigation">
    <div class="nav-inner">
      <!-- Left: Minimal Back Button -->
      <div class="nav-spacer" style="display: flex; align-items: center;">
        <a href="/" class="nav-back-btn" aria-label="Back to Home">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>HOME</span>
        </a>
      </div>
      <a href="/" class="nav-logo--center" aria-label="RPG Catering Home">
        RPG CATERING
      </a>
      <button class="nav-hamburger" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
      <a href="/#services">Services</a>
      <a href="/food">Explore Our Food</a>
      <a href="/gallery">Gallery</a>
      <a href="/#about">About</a>
      <a href="/#contact">Enquire Now</a>
    </div>
  </nav>

  <!-- ===== PARALLAX GALLERY ===== -->
  <section id="gallery" class="gallery-parallax" aria-labelledby="gallery-heading" style="padding-top: 12rem;">
    <div class="gallery-parallax__header">
      <h2 id="gallery-heading" class="gallery-parallax__title">Our Gallery</h2>
      <p class="gallery-parallax__sub">A closer look at our curated moments</p>
    </div>
    
    <div class="gallery-parallax__grid" id="parallaxContainer">
      <!-- Left Column -->
      <div class="gp-col">
        <% gallery.forEach((img, i) => { if (i % 3 === 0) { %>
        <div class="gp-item"><img src="<%= img.image_url %>" alt="Gallery image" loading="lazy"></div>
        <% } }) %>
      </div>
      <!-- Center Column (Slow - Parallax) -->
      <div class="gp-col gp-col-slow" id="parallaxCenter">
        <% gallery.forEach((img, i) => { if (i % 3 === 1) { %>
        <div class="gp-item"><img src="<%= img.image_url %>" alt="Gallery image" loading="lazy"></div>
        <% } }) %>
      </div>
      <!-- Right Column -->
      <div class="gp-col">
        <% gallery.forEach((img, i) => { if (i % 3 === 2) { %>
        <div class="gp-item"><img src="<%= img.image_url %>" alt="Gallery image" loading="lazy"></div>
        <% } }) %>
      </div>
    </div>
  </section>

  <!-- ===== LIGHTBOX OVERLAY ===== -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox__close" id="lbClose" aria-label="Close Lightbox">&times;</button>
    <button class="lightbox__prev" id="lbPrev" aria-label="Previous Image">&#10094;</button>
    <img src="" alt="Expanded Image" class="lightbox__img" id="lbImg">
    <button class="lightbox__next" id="lbNext" aria-label="Next Image">&#10095;</button>
  </div>

  <footer class="footer" role="contentinfo">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo-mark">RPG</span>
        <p class="footer-tagline">Crafting Celebrations Since 2006</p>
      </div>
      <div class="footer-links">
        <a href="/#services">Services</a>
        <a href="/food">Explore Our Food</a>
        <a href="/gallery">Gallery</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </div>
      <div class="footer-location">
        <p>Manjakkuppam, Cuddalore</p>
        <p>Tamil Nadu, India</p>
        <p>Opens at 08:00 AM</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 RPG Catering and Event Management Service. All rights reserved.</p>
    </div>
  </footer>

  <!-- ===== WHATSAPP FLOATING BUTTON ===== -->
  <a href="https://wa.me/919600662794" class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <script src="script.js"></script>
</body>
</html>
